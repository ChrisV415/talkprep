{
  "expo": {
    "name": "TalkPrep",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9f5ef"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "TalkPrep",
      "shortName": "TalkPrep",
      "description": "AI-powered conversation prep — practice interviews, pitches, and tough talks.",
      "themeColor": "#C67C4E",
      "backgroundColor": "#F9F2ED",
      "lang": "en",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
